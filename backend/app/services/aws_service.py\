import boto3
import uuid
from datetime import datetime, timedelta, timezone


REGION = "ap-south-1"
TABLE_NAME = "cloudops-sentinel-incidents"


def get_aws_account_identity():
    sts = boto3.client(
        "sts",
        region_name=REGION
    )

    return sts.get_caller_identity()


def get_incidents_table():
    dynamodb = boto3.resource(
        "dynamodb",
        region_name=REGION
    )

    return dynamodb.Table(TABLE_NAME)


def get_cloudwatch_client():
    return boto3.client(
        "cloudwatch",
        region_name=REGION
    )


def get_ec2_cpu_metrics(instance_id, start_time, end_time):
    cloudwatch = get_cloudwatch_client()

    response = cloudwatch.get_metric_statistics(
        Namespace="AWS/EC2",
        MetricName="CPUUtilization",
        Dimensions=[
            {
                "Name": "InstanceId",
                "Value": instance_id
            }
        ],
        StartTime=start_time,
        EndTime=end_time,
        Period=300,
        Statistics=["Average"]
    )

    return response.get("Datapoints", [])


def get_latest_ec2_cpu(instance_id):
    end_time = datetime.now(timezone.utc)
    start_time = end_time - timedelta(minutes=15)

    datapoints = get_ec2_cpu_metrics(
        instance_id,
        start_time,
        end_time
    )

    if not datapoints:
        return None

    latest = max(
        datapoints,
        key=lambda point: point["Timestamp"]
    )

    return latest["Average"]


def check_high_cpu(instance_id, threshold=80):
    cpu = get_latest_ec2_cpu(instance_id)

    if cpu is None:
        return {
            "status": "NO_DATA",
            "cpu": None,
            "threshold": threshold
        }

    if cpu >= threshold:
        return {
            "status": "HIGH_CPU",
            "cpu": cpu,
            "threshold": threshold
        }

    return {
        "status": "NORMAL",
        "cpu": cpu,
        "threshold": threshold
    }


def create_cpu_incident(instance_id, cpu):
    table = get_incidents_table()

    now = datetime.now(timezone.utc).isoformat()

    incident = {
        "incident_id": str(uuid.uuid4()),
        "resource": instance_id,
        "type": "HIGH_CPU",
        "severity": "HIGH",
        "status": "OPEN",
        "description": f"EC2 CPU utilization exceeded 80%. Current CPU: {cpu:.2f}%",
        "region": REGION,
        "created_at": now,
        "updated_at": now
    }

    table.put_item(
        Item=incident
    )

    return incident
